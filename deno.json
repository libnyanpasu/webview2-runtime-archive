    "discover": "deno run --allow-net main.ts --dry-run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@octokit/rest": "npm:@octokit/rest@^21",
    "@std/async/retry": "jsr:@std/async@1/retry"
  }
}
